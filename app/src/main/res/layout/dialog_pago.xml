<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Método de pago"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_metodo_pago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_credito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tarjeta de Crédito" />

            <RadioButton
                android:id="@+id/rb_debito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tarjeta de Débito" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Datos de la tarjeta"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_tarjeta_numero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número de tarjeta"
            android:inputType="number"
            android:maxLength="19"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_tarjeta_titular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Titular"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_tarjeta_vencimiento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="MM/AA"
                android:inputType="number"
                android:maxLength="5"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/et_tarjeta_cvv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="CVV"
                android:inputType="number"
                android:maxLength="4" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
